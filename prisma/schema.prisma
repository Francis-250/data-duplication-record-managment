generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Better Auth Core Models
// Strictly preserving core models as required: User, Session, Account, Verification, TwoFactor
// -----------------------------------------------------------------------------

model User {
  id                  String      @id
  name                String
  email               String
  emailVerified       Boolean     @default(false)
  image               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  role                String?
  banned              Boolean?    @default(false)
  banReason           String?
  banExpires          DateTime?
  phoneNumber         String?
  phoneNumberVerified Boolean?
  username            String?
  displayUsername     String?
  twoFactorEnabled    Boolean?    @default(false)
  sessions            Session[]
  accounts            Account[]
  twofactors          TwoFactor[]

  @@unique([email])
  @@unique([phoneNumber])
  @@unique([username])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String   @id
  secret      String
  backupCodes String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean? @default(true)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// -----------------------------------------------------------------------------
// DATA DEDUPLICATION AND RECORD MATCHING SYSTEM — Enums
// -----------------------------------------------------------------------------

enum InstitutionalRecordType {
  STUDENT
  APPLICANT
  STAFF
}

enum InstitutionalRecordStatus {
  ACTIVE
  INACTIVE
  MERGED
  ARCHIVED
}

enum ImportStatus {
  PENDING
  VALIDATING
  VALID
  PARTIALLY_VALID
  INVALID
  IMPORTED
  FAILED
}

enum MatchClassification {
  MATCH
  POSSIBLE_MATCH
  NON_MATCH
}

enum MatchReviewStatus {
  PENDING
  UNDER_REVIEW
  CONFIRMED
  REJECTED
  MERGED
  CANCELLED
}

enum MatchRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// -----------------------------------------------------------------------------
// DATA DEDUPLICATION AND RECORD MATCHING SYSTEM — Models
// -----------------------------------------------------------------------------

model InstitutionalRecord {
  id                 String                    @id @default(cuid())
  recordType         InstitutionalRecordType   @default(STUDENT)
  firstName          String
  middleName         String?
  lastName           String
  fullName           String
  gender             String?
  dateOfBirth        DateTime?
  nationalId         String?
  passportNumber     String?
  registrationNumber String?
  applicantNumber    String?
  staffNumber        String?
  email              String?
  phoneNumber        String?
  programme          String?
  department         String?
  faculty            String?
  campus             String?
  intake             String?
  academicYear       String?
  address            String?
  recordSource       String?
  status             InstitutionalRecordStatus @default(ACTIVE)

  studentUserId   String?
  submittedById   String?
  datasetImportId String?

  standardizedName               String?
  standardizedEmail              String?
  standardizedPhone              String?
  standardizedRegistrationNumber String?
  standardizedNationalId         String?

  mergedIntoId String?
  mergedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  datasetImport      DatasetImport?   @relation(fields: [datasetImportId], references: [id], onDelete: SetNull)
  recordAComparisons MatchCandidate[] @relation("RecordA")
  recordBComparisons MatchCandidate[] @relation("RecordB")
  masterMerges       RecordMerge[]    @relation("MasterRecord")
  sourceMerges       RecordMerge[]    @relation("SourceRecord")

  @@index([studentUserId])
  @@index([registrationNumber])
  @@index([nationalId])
  @@index([email])
  @@index([phoneNumber])
  @@index([fullName])
  @@index([status])
  @@index([datasetImportId])
  @@map("institutional_record")
}

model DatasetImport {
  id               String       @id @default(cuid())
  originalFileName String
  storedFileName   String?
  fileUrl          String?
  fileSize         Int?
  mimeType         String?
  uploadedById     String
  status           ImportStatus @default(PENDING)
  totalRows        Int          @default(0)
  validRows        Int          @default(0)
  invalidRows      Int          @default(0)
  duplicateRows    Int          @default(0)
  validationErrors Json?
  importedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  records   InstitutionalRecord[]
  matchRuns MatchRun[]

  @@index([uploadedById])
  @@index([status])
  @@index([createdAt])
  @@map("dataset_import")
}

model MatchRun {
  id                String         @id @default(cuid())
  datasetImportId   String?
  startedById       String
  status            MatchRunStatus @default(PENDING)
  algorithm         String
  modelVersion      String?
  matchThreshold    Float
  possibleThreshold Float
  recordsProcessed  Int            @default(0)
  candidatePairs    Int            @default(0)
  matchesFound      Int            @default(0)
  possibleMatches   Int            @default(0)
  nonMatches        Int            @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  errorMessage      String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  datasetImport DatasetImport?   @relation(fields: [datasetImportId], references: [id], onDelete: SetNull)
  candidates    MatchCandidate[]

  @@index([datasetImportId])
  @@index([startedById])
  @@index([status])
  @@index([createdAt])
  @@map("match_run")
}

model MatchCandidate {
  id              String              @id @default(cuid())
  matchRunId      String
  recordAId       String
  recordBId       String
  overallScore    Float
  confidenceScore Float
  classification  MatchClassification
  reviewStatus    MatchReviewStatus   @default(PENDING)
  explanation     String?             @db.Text
  algorithm       String
  modelVersion    String?
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  matchRun         MatchRun            @relation(fields: [matchRunId], references: [id], onDelete: Cascade)
  recordA          InstitutionalRecord @relation("RecordA", fields: [recordAId], references: [id], onDelete: Cascade)
  recordB          InstitutionalRecord @relation("RecordB", fields: [recordBId], references: [id], onDelete: Cascade)
  fieldComparisons FieldComparison[]
  merge            RecordMerge?

  @@unique([matchRunId, recordAId, recordBId])
  @@index([recordAId])
  @@index([recordBId])
  @@index([classification])
  @@index([reviewStatus])
  @@index([overallScore])
  @@map("match_candidate")
}

model FieldComparison {
  id               String   @id @default(cuid())
  matchCandidateId String
  fieldName        String
  recordAValue     String?
  recordBValue     String?
  standardizedA    String?
  standardizedB    String?
  similarityMethod String
  similarityScore  Float
  isExactMatch     Boolean  @default(false)
  createdAt        DateTime @default(now())

  matchCandidate MatchCandidate @relation(fields: [matchCandidateId], references: [id], onDelete: Cascade)

  @@index([matchCandidateId])
  @@index([fieldName])
  @@map("field_comparison")
}

model RecordMerge {
  id               String   @id @default(cuid())
  matchCandidateId String   @unique
  masterRecordId   String
  sourceRecordId   String
  mergedById       String
  selectedValues   Json
  previousValues   Json?
  mergeReason      String?  @db.Text
  mergedAt         DateTime @default(now())
  createdAt        DateTime @default(now())

  matchCandidate MatchCandidate      @relation(fields: [matchCandidateId], references: [id], onDelete: Restrict)
  masterRecord   InstitutionalRecord @relation("MasterRecord", fields: [masterRecordId], references: [id], onDelete: Restrict)
  sourceRecord   InstitutionalRecord @relation("SourceRecord", fields: [sourceRecordId], references: [id], onDelete: Restrict)

  @@index([masterRecordId])
  @@index([sourceRecordId])
  @@index([mergedById])
  @@index([mergedAt])
  @@map("record_merge")
}

model DeduplicationAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  entityType   String?
  entityId     String?
  description  String?  @db.Text
  previousData Json?
  newData      Json?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("deduplication_audit_log")
}

model DeduplicationSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("deduplication_setting")
}
